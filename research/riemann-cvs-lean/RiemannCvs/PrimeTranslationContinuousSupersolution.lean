theorem c13ContinuousActualPrimeTranslationRow_lt_tenThird (t : ℝ)
    (htLower : (1 : ℝ) ≤ t) (htUpper : t ≤ 13) :
    c13ContinuousActualPrimeTranslationRow t <
      (10 / 3 : ℝ) * c13ContinuousSupersolutionHeight t := by
  calc
    c13ContinuousActualPrimeTranslationRow t
        ≤ c13ContinuousUpperPrimeTranslationRow t :=
      c13ContinuousActualPrimeTranslationRow_le_upper t
    _ ≤ (33223 / 10000 : ℝ) * c13ContinuousSupersolutionHeight t :=
      c13ContinuousSupersolution_all_upper_rows_le t htLower htUpper
    _ < (10 / 3 : ℝ) * c13ContinuousSupersolutionHeight t := by
      apply mul_lt_mul_of_pos_right _ (c13ContinuousSupersolutionHeight_pos t)
      norm_num

